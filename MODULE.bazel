"""Word Bank. `bazel build //:word_bank_html` packs the app into one HTML file; `bazel test //...` tests it.

Bazel brings its own pinned Node.js, so neither needs Node installed. The page itself needs no build:
web/index.html runs straight from disk.
"""

module(name = "ssat_vocab")

bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_shell", version = "0.8.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")
use_repo(node, "nodejs")
