load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files(["ssat_vocab_410.jsonl"])

py_library(
    name = "ssat_vocab",
    srcs = glob(["ssat_vocab/*.py"]),
    data = [
        "ssat_vocab_410.jsonl",
        "//web",
    ],
    imports = ["."],
    deps = [
        requirement("fastapi"),
        requirement("uvicorn"),
    ],
)

# bazel run //:app [-- --host 0.0.0.0 --port 8000]
py_binary(
    name = "app",
    srcs = ["ssat_vocab/server.py"],
    main = "ssat_vocab/server.py",
    deps = [":ssat_vocab"],
)

[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        size = "small",
        srcs = [src],
        main = src,
        deps = [
            ":ssat_vocab",
            requirement("pytest"),
            requirement("httpx"),
        ],
    )
    for src in glob(["tests/*_test.py"])
]
